# Copiar a backend/.env para desarrollo local (npm run dev la lee sola). En Render se cargan en el panel.

# Clave de la API de Anthropic (https://console.anthropic.com). Sin ella, solo funciona el modelo local.
ANTHROPIC_API_KEY=
# Modelo maestro de visión (default claude-haiku-5-5, el más barato).
# Alternativas: claude-sonnet-5-5 (más preciso) o claude-opus-5-5 (el más preciso y caro).
CLAUDE_MODEL=claude-haiku-5-5
# Esfuerzo de razonamiento: low | medium | high (más esfuerzo = más preciso y más caro)
CLAUDE_EFFORT=medium

# Puerto (Render lo define solo)
PORT=8000
# Dominios de la interfaz que pueden llamar a la API, separados por comas; acepta comodines.
# Vacío = cualquiera (solo para desarrollo). Ej.: https://lavirshion.vercel.app,https://*.vercel.app
CORS_ORIGINS=

# Carpeta de la base y las fotos guardadas (default: data/ en la raíz del repo; en Render, /var/data)
DATA_DIR=
# Nombre de la base dentro de DATA_DIR (default quality_control.db)
DB_PATH=
# Por debajo de esta confianza del maestro, la muestra espera revisión humana (default 0.7)
FEEDBACK_MIN_TEACHER_CONF=

# Modelo entrenado: carpeta con centinela.onnx y centinela.json (default backend/models)
LOCAL_MODEL_DIR=
# Opcional: si faltan, se descargan de acá al arrancar (por ejemplo, un release de GitHub)
MODEL_URL=
MODEL_META_URL=
