# Clave de la API de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Opcional: modelo maestro de visión (default claude-haiku-5-5, el más barato).
# Alternativas: claude-sonnet-5-5 (más preciso) o claude-opus-5-5 (el más preciso y caro).
CLAUDE_MODEL=claude-haiku-5-5
# Opcional: esfuerzo de razonamiento: low | medium | high (más esfuerzo = más preciso y más caro)
CLAUDE_EFFORT=medium
# Opcional: carpeta del modelo local exportado por ml/export.py (default public/models)
LOCAL_MODEL_DIR=public/models
# Opcional: base SQLite de inspecciones y retroalimentación (default data/quality_control.db)
DB_PATH=data/quality_control.db
